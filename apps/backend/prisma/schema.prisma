generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
}

enum Role {
  CUSTOMER
  RESTAURANT
  DELIVERY
  ADMIN
}
